# Save as ios/fastlane/Fastfile  (Flutter app or bare React Native app: an Xcode project already exists)
# Values come from the workflow's env:
#   XC_PROJECT    e.g. Runner.xcodeproj        (Flutter)   or  MyApp.xcodeproj       (React Native)
#   XC_WORKSPACE  e.g. Runner.xcworkspace      (Flutter)   or  MyApp.xcworkspace     (React Native)
#   XC_SCHEME     e.g. Runner                  (Flutter)   or  MyApp                 (React Native)
#   BUNDLE_ID     the registered bundle ID
default_platform(:ios)

def asc_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_P8_BASE64"],
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  desc "Signing setup: create the certificate and profile, store them in the match repo"
  lane :certs do
    setup_ci
    match(type: "appstore", readonly: false, api_key: asc_key, app_identifier: ENV["BUNDLE_ID"])
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci
    key = asc_key
    match(type: "appstore", readonly: true, api_key: key, app_identifier: ENV["BUNDLE_ID"])

    # Switch the app target to manual signing with the profile match just installed.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: ENV["XC_PROJECT"],
      team_id: ENV["APPLE_TEAM_ID"],
      bundle_identifier: ENV["BUNDLE_ID"],
      profile_name: "match AppStore #{ENV['BUNDLE_ID']}",
      code_sign_identity: "Apple Distribution",
      build_configurations: ["Release"]
    )

    build_app(
      workspace: ENV["XC_WORKSPACE"],
      scheme: ENV["XC_SCHEME"],
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}"
    )

    upload_to_testflight(
      api_key: key,
      apple_id: ENV["ASC_APP_ID"],
      skip_waiting_for_build_processing: true
    )
  end
end
